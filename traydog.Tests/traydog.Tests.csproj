<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="MSTest" Version="4.4.1" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Microsoft.VisualStudio.TestTools.UnitTesting" />
  </ItemGroup>

  <!--
    The app targets net10.0-windows and pulls in WinUI/WinRT, which a plain test host can't load.
    Rather than reference it, link in the individual files that are deliberately free of platform
    dependencies. Keep this list to pure logic: anything that needs ApplicationData, a
    DispatcherQueue, or Win32 doesn't belong here.
  -->
  <ItemGroup>
    <Compile Include="..\Monitoring\NetState.cs" Link="Monitoring\NetState.cs" />
    <Compile Include="..\Monitoring\StatusText.cs" Link="Monitoring\StatusText.cs" />
    <Compile Include="..\Monitoring\CheckInterval.cs" Link="Monitoring\CheckInterval.cs" />
    <Compile Include="..\Monitoring\ConnectivityMonitor.cs" Link="Monitoring\ConnectivityMonitor.cs" />
    <Compile Include="..\Platform\PopoutPlacement.cs" Link="Platform\PopoutPlacement.cs" />
    <Compile Include="..\Situations\Situation.cs" Link="Situations\Situation.cs" />
    <Compile Include="..\Situations\SituationPolicy.cs" Link="Situations\SituationPolicy.cs" />
    <Compile Include="..\Situations\SituationText.cs" Link="Situations\SituationText.cs" />
    <Compile Include="..\Situations\SituationJson.cs" Link="Situations\SituationJson.cs" />
    <Compile Include="..\Resources\ResourceModel.cs" Link="Resources\ResourceModel.cs" />
    <Compile Include="..\Resources\ResourcePolicy.cs" Link="Resources\ResourcePolicy.cs" />
    <Compile Include="..\Resources\ResourceAlertList.cs" Link="Resources\ResourceAlertList.cs" />
    <Compile Include="..\Resources\ProcessSampler.cs" Link="Resources\ProcessSampler.cs" />
    <Compile Include="..\UI\MonitoringLayout.cs" Link="UI\MonitoringLayout.cs" />
  </ItemGroup>

</Project>
